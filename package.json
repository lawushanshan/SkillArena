{
  "name": "skillarena",
  "version": "0.1.0",
  "description": "Local-first evaluation harness for Codex skills.",
  "type": "module",
  "bin": {
    "skillarena": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "prepare": "npm run build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write src"
  },
  "keywords": [
    "codex",
    "skills",
    "eval",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "cross-spawn": "^7.0.6",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "^4.0.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lawushanshan/SkillArena.git"
  },
  "bugs": {
    "url": "https://github.com/lawushanshan/SkillArena/issues"
  },
  "homepage": "https://github.com/lawushanshan/SkillArena#readme",
  "author": "SkillArena Contributors"
}
